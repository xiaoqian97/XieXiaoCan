.blessing-page { min-height: 100vh; padding: 26rpx 26rpx calc(54rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #FFF9ED; color: #3F302B; }
.blessing-hero { position: relative; overflow: hidden; padding: 38rpx 34rpx 32rpx; border-radius: 34rpx; background: linear-gradient(135deg, #FFE7A8, #FFF3D5 54%, #FFD9CF); box-shadow: 0 12rpx 32rpx rgba(108, 68, 45, .1); }
.hero-orb { position: absolute; border-radius: 50%; opacity: .35; }.orb-one { width: 190rpx; height: 190rpx; top: -90rpx; right: -30rpx; background: #FF8C78; }.orb-two { width: 130rpx; height: 130rpx; bottom: -70rpx; left: 90rpx; background: #F6C85F; }
.hero-emoji,.hero-title,.hero-desc { position: relative; z-index: 1; display: block; }.hero-emoji { font-size: 48rpx; }.hero-title { margin-top: 10rpx; font-size: 40rpx; font-weight: 800; }.hero-desc { margin-top: 8rpx; color: #8C6D63; font-size: 24rpx; }
.hero-button { position: relative; z-index: 1; width: 250rpx; height: 70rpx; margin: 26rpx 0 0; color: #fff; font-size: 25rpx; font-weight: 600; line-height: 70rpx; border-radius: 35rpx; background: linear-gradient(135deg,#F06B55,#E85D4A); box-shadow: 0 8rpx 18rpx rgba(232,93,74,.2); }.hero-button::after { border: 0; }
.blessing-tabs { display: flex; margin: 28rpx 0 20rpx; padding: 7rpx; border-radius: 24rpx; background: #F3EAE4; }.blessing-tab { height: 64rpx; flex: 1; color: #8C7770; font-size: 25rpx; line-height: 64rpx; text-align: center; border-radius: 19rpx; }.blessing-tab.active { color: #D94A3A; font-weight: 700; background: #fff; box-shadow: 0 5rpx 14rpx rgba(63,48,43,.08); }
.page-state { display: flex; min-height: 420rpx; align-items: center; justify-content: center; flex-direction: column; color: #A9958E; font-size: 25rpx; }.state-emoji { font-size: 72rpx; }.state-title { margin-top: 20rpx; color: #5E4A43; font-size: 30rpx; font-weight: 700; }.state-desc { margin-top: 10rpx; font-size: 23rpx; }
.blessing-list { display: flex; flex-direction: column; gap: 18rpx; }.blessing-item { position: relative; display: flex; overflow: hidden; min-height: 190rpx; padding: 26rpx 46rpx 24rpx 24rpx; align-items: flex-start; box-sizing: border-box; border: 1rpx solid rgba(232,222,216,.8); border-radius: 28rpx; background: linear-gradient(135deg,#fff,#FFF5E4); box-shadow: 0 7rpx 20rpx rgba(63,48,43,.06); }.item-decoration { position:absolute; width:130rpx; height:130rpx; right:-55rpx; bottom:-65rpx; border-radius:50%; background:rgba(246,200,95,.18); }.item-icon { display:flex; width:68rpx; height:68rpx; flex-shrink:0; align-items:center; justify-content:center; font-size:34rpx; border-radius:22rpx; background:rgba(255,255,255,.72); }.item-content { min-width:0; flex:1; margin-left:18rpx; }.item-top { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }.item-person { color:#8C7770; font-size:21rpx; }.item-status { color:#D98A26; font-size:20rpx; }.status-sent { color:#D98A26; }.status-dismissed { color:#9A8178; }.status-viewed { color:#46A66C; }.status-cancelled,.status-failed { color:#B69F97; }.item-title { display:block; margin-top:8rpx; overflow:hidden; color:#3F302B; font-size:29rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }.item-copy { display:-webkit-box; margin-top:7rpx; overflow:hidden; color:#7F6962; font-size:23rpx; line-height:1.45; -webkit-box-orient:vertical; -webkit-line-clamp:2; }.item-time { display:block; margin-top:10rpx; color:#B09B94; font-size:20rpx; }.item-arrow { position:absolute; top:50%; right:20rpx; color:#C9B8B1; font-size:42rpx; transform:translateY(-50%); }
.theme-anniversary,.theme-missing-you { background:linear-gradient(135deg,#FFF,#FFE7EA); }.theme-night { background:linear-gradient(135deg,#FFF,#EEE9FF); }.theme-birthday { background:linear-gradient(135deg,#FFF,#E8FAF3); }.theme-morning { background:linear-gradient(135deg,#FFFDF0,#FFECC2); }
.theme-new-year { background:linear-gradient(135deg,#FFF8E9,#FFE0A4); }.theme-valentine { background:linear-gradient(135deg,#FFF6F8,#FFDCE5); }.theme-spring { background:linear-gradient(135deg,#FFF7F1,#FFCFC0); }.theme-labor { background:linear-gradient(135deg,#FFFCEB,#E7F3CE); }.theme-children { background:linear-gradient(135deg,#F4FCFF,#FFE5F0); }.theme-qixi { background:linear-gradient(135deg,#F8F6FF,#DDD8FF); }.theme-mid-autumn { background:linear-gradient(135deg,#FFFDF5,#DDE8FF); }.theme-national { background:linear-gradient(135deg,#FFF5EC,#FFE2A6); }
