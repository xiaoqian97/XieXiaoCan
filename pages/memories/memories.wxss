.memory-page {
  min-height: 100vh;
  padding: 36rpx 28rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #FFF4E8 0, #fff 380rpx);
}

.memory-header {
  margin: 12rpx 8rpx 28rpx;
}

.memory-title,
.memory-subtitle {
  display: block;
}

.memory-title {
  color: #3F302B;
  font-size: 44rpx;
  font-weight: 700;
}

.memory-subtitle {
  margin-top: 12rpx;
  color: #A9958E;
  font-size: 26rpx;
}

.overall-card,
.person-memory {
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(244, 114, 182, 0.1);
}

.overall-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 30rpx 12rpx;
}

.overall-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.overall-number,
.stat-number {
  color: #D94A3A;
  font-size: 40rpx;
  font-weight: 700;
}

.overall-label,
.person-stats text:not(.stat-number) {
  margin-top: 8rpx;
  color: #A9958E;
  font-size: 22rpx;
}

.overall-divider {
  width: 1rpx;
  height: 54rpx;
  background: #F5ECE6;
}

.people-scroll {
  margin: 28rpx -28rpx;
  white-space: nowrap;
}

.people-list,
.favorite-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 28rpx;
}

.person-tab {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx 10rpx 10rpx;
  border: 2rpx solid transparent;
  border-radius: 44rpx;
  background: #fff;
  color: #8C7770;
  font-size: 26rpx;
}

.person-tab.active {
  border-color: #E85D4A;
  background: #FFF4E8;
  color: #C83D32;
  font-weight: 600;
}

.person-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
}

.person-memory {
  padding: 28rpx;
}

.section-heading,
.recent-meal {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-heading {
  color: #3F302B;
  font-size: 32rpx;
  font-weight: 600;
}

.section-note {
  color: #E85D4A;
  font-size: 22rpx;
  font-weight: 400;
}

.person-stats {
  display: flex;
  justify-content: space-around;
  margin: 28rpx 0;
  padding: 24rpx 0;
  border-radius: 18rpx;
  background: #FFF9ED;
}

.person-stats view {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.memory-section {
  margin-top: 32rpx;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  color: #6E5852;
  font-size: 28rpx;
  font-weight: 600;
}

.recipe-row {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.recipe-chip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #6E5852;
  font-size: 26rpx;
}

.recipe-chip image {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
}

.recipe-chip view,
.favorite-card {
  display: flex;
  flex-direction: column;
}

.recipe-count {
  margin-top: 4rpx;
  color: #A9958E;
  font-size: 22rpx;
}

.favorite-scroll {
  white-space: nowrap;
}

.favorite-list {
  padding: 0;
}

.favorite-card {
  width: 150rpx;
  gap: 8rpx;
  color: #6E5852;
  font-size: 23rpx;
  white-space: normal;
}

.favorite-card image {
  width: 150rpx;
  height: 110rpx;
  border-radius: 16rpx;
}

.praise-card {
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fffbeb;
}

.praise-title,
.praise-content {
  display: block;
}

.praise-title {
  color: #b45309;
  font-size: 26rpx;
  font-weight: 600;
}

.praise-content {
  margin-top: 10rpx;
  color: #92400e;
  font-size: 24rpx;
  line-height: 1.6;
}

.recent-meal {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5ECE6;
}

.meal-date {
  width: 90rpx;
  color: #E85D4A;
  font-size: 24rpx;
}

.meal-recipes {
  flex: 1;
  overflow: hidden;
  color: #6E5852;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meal-arrow {
  margin-left: 16rpx;
  color: #A9958E;
  font-size: 32rpx;
}

.state-view {
  display: flex;
  min-height: 58vh;
  align-items: center;
  justify-content: center;
  color: #A9958E;
  font-size: 28rpx;
}

.empty-state {
  flex-direction: column;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
}

.empty-text {
  margin: 24rpx 30rpx 32rpx;
  color: #8C7770;
  font-size: 28rpx;
}

.go-recipes {
  width: 270rpx;
  border-radius: 44rpx;
  background: #D94A3A;
  color: #fff;
  font-size: 28rpx;
}

.go-recipes::after {
  border: none;
}
