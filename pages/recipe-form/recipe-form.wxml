<view class="recipe-container">
  <login-prompt id="loginPrompt" />

  <view wx:if="{{initialLoading}}" class="form-loading-mask" catchtap="stopInitialLoadingEvent" catchtouchmove="stopInitialLoadingEvent">
    <view class="form-loading-card">
      <text class="form-loading-icon">📝</text>
      <van-loading size="26px" color="#E85D4A" />
      <text class="form-loading-title">正在准备菜谱</text>
      <text class="form-loading-desc">原来的内容加载完成后才能编辑</text>
    </view>
  </view>

  <view wx:elif="{{initialLoadError}}" class="form-loading-mask" catchtouchmove="stopInitialLoadingEvent">
    <view class="form-loading-card">
      <text class="form-loading-icon">🥣</text>
      <text class="form-loading-title">内容暂时没加载出来</text>
      <text class="form-loading-desc">{{initialLoadError}}</text>
      <button class="form-retry-button" bindtap="retryInitialLoad">重新加载</button>
    </view>
  </view>

  <!-- 表单内容 -->
  <scroll-view class="form-content" scroll-y="true" show-scrollbar="{{false}}">
    
    <!-- 馋图 -->
    <view class="form-section">
      <text class="section-label {{imageRequiredClass}}">{{imageLabel}}（{{formData.images.length}}/5）</text>
      <text class="image-ratio-tip">建议使用方形图片，上传后统一裁剪为 1:1；可自行设置封面</text>
      <view class="images-container">
        <!-- 已上传的图片 -->
        <block wx:for="{{formData.images}}" wx:key="index">
          <view class="image-item">
            <cloud-image class="uploaded-image" custom-class="uploaded-image" src="{{item}}" fallback="/images/default-recipe.jpg" />
            <view wx:if="{{index === 0}}" class="cover-badge">封面</view>
            <view wx:else class="set-cover-button" data-index="{{index}}" catchtap="setCoverImage">设为封面</view>
            <view class="image-delete" bindtap="removeImage" data-index="{{index}}">
              <van-icon name="cross" size="16px" color="#fff" />
            </view>
          </view>
        </block>

        <!-- 上传按钮 -->
        <view wx:if="{{formData.images.length < 5}}" class="image-upload" bindtap="onImageUpload">
          <van-icon name="photograph" size="32px" color="#D8CCC6" />
          <text class="upload-text">加张馋图</text>
        </view>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="form-section {{filledFlash ? 'just-filled' : ''}}">
      <view class="input-group">
        <text class="input-label required">{{nameLabel}}</text>
        <van-field 
          value="{{formData.name}}" 
          placeholder="比如：红烧肉、番茄鸡蛋"
          maxlength="20"
          show-word-limit
          bind:change="onNameChange"
        />
      </view>

      <view class="input-group">
        <text class="input-label">{{descriptionLabel}}</text>
        <van-field 
          value="{{formData.description}}" 
          placeholder="{{descriptionPlaceholder}}"
          type="textarea"
          maxlength="100"
          show-word-limit
          autosize
          bind:change="onDescriptionChange"
        />
      </view>
    </view>

    <!-- 场景分类（必选） -->
    <view class="form-section">
      <text class="section-label required">这道菜适合什么时候吃？</text>
      <view class="scene-grid">
        <block wx:for="{{sceneCategories}}" wx:key="id">
          <view
            class="scene-card {{formData.sceneCategory === item.id ? 'selected' : ''}}"
            bindtap="onSceneCategorySelect"
            data-id="{{item.id}}"
          >
            <view class="scene-emoji">{{item.emoji}}</view>
            <view class="scene-name">{{item.name}}</view>
            <view class="scene-desc">{{item.description}}</view>
          </view>
        </block>
      </view>
    </view>

    <!-- 食材分类（必选） -->
    <view class="form-section">
      <text class="section-label required">主角食材是什么？</text>
      <view class="ingredient-grid">
        <block wx:for="{{ingredientCategories}}" wx:key="id">
          <view
            class="ingredient-card {{formData.ingredientCategory === item.id ? 'selected' : ''}}"
            bindtap="onIngredientCategorySelect"
            data-id="{{item.id}}"
          >
            <view class="ingredient-emoji">{{item.emoji}}</view>
            <view class="ingredient-name">{{item.name}}</view>
          </view>
        </block>
      </view>
    </view>

    <!-- 上桌信息 -->
    <view wx:if="{{showCookingInfo}}" class="form-section">
      <text class="section-label">上桌信息</text>
      <view class="info-row">
        <view class="info-column">
          <text class="info-label">上桌用时</text>
          <picker 
            range="{{preparationTimes}}" 
            range-key="label"
            value="{{formData.preparationTimeIndex}}"
            bindchange="onPreparationTimeChange"
          >
            <view class="picker-field">
              {{preparationTimes && preparationTimes.length > 0 && formData.preparationTimeIndex >= 0 && formData.preparationTimeIndex < preparationTimes.length ? preparationTimes[formData.preparationTimeIndex].label : '请选择'}}
            </view>
          </picker>
        </view>

        <view class="info-column">
          <text class="info-label">操作难度</text>
          <picker 
            range="{{difficultyLevels}}" 
            range-key="label"
            value="{{formData.difficultyIndex}}"
            bindchange="onDifficultyChange"
          >
            <view class="picker-field">
              {{difficultyLevels && difficultyLevels.length > 0 && formData.difficultyIndex >= 0 && formData.difficultyIndex < difficultyLevels.length ? difficultyLevels[formData.difficultyIndex].label : '请选择'}}
            </view>
          </picker>
        </view>

        <view class="info-column">
          <text class="info-label">几个人吃</text>
          <picker 
            range="{{servingSizes}}" 
            range-key="label"
            value="{{formData.servingSizeIndex}}"
            bindchange="onServingSizeChange"
          >
            <view class="picker-field">
              {{servingSizes && servingSizes.length > 0 && formData.servingSizeIndex >= 0 && formData.servingSizeIndex < servingSizes.length ? servingSizes[formData.servingSizeIndex].label : '请选择'}}
            </view>
          </picker>
        </view>
      </view>
    </view>

    <!-- 可选标签 -->
    <view class="form-section">
      <view class="optional-tags-header">
        <text class="section-label">口味标签（可选）</text>
        <text class="toggle-btn" bindtap="toggleMoreTags">
          {{showMoreTags ? '收起' : '展开'}}
          <van-icon name="{{showMoreTags ? 'arrow-up' : 'arrow-down'}}" size="12px" />
        </text>
      </view>
      
      
      <block wx:if="{{showMoreTags}}">
        <!-- 做法偏好 -->
        <view class="tag-group">
          <text class="tag-group-title">做法偏好</text>
          <view class="tag-list">
            <block wx:for="{{cookingMethods}}" wx:key="id">
              <view
                class="optional-tag {{item.selected ? 'selected' : 'unselected'}}"
                bindtap="onOptionalTagToggle"
                data-id="{{item.id}}"
              >
                <text wx:if="{{item.selected}}" class="tag-checkmark">✓ </text>{{item.emoji}} {{item.name}}
              </view>
            </block>
          </view>
        </view>
        
        <!-- 口味偏好 -->
        <view class="tag-group">
          <text class="tag-group-title">口味偏好</text>
          <view class="tag-list">
            <block wx:for="{{flavorTypes}}" wx:key="id">
              <view
                class="optional-tag {{item.selected ? 'selected' : 'unselected'}}"
                bindtap="onOptionalTagToggle"
                data-id="{{item.id}}"
              >
                <text wx:if="{{item.selected}}" class="tag-checkmark">✓ </text>{{item.emoji}} {{item.name}}
              </view>
            </block>
          </view>
        </view>
      </block>
    </view>

    <!-- 备菜清单 -->
    <view class="form-section {{filledFlash ? 'just-filled' : ''}}">
      <view class="section-header">
        <view>
          <text class="section-label {{ingredientRequiredClass}}">食材{{optionalSuffix}}</text>
          <text class="section-tip">填写主要食材和用量</text>
        </view>
        <text class="section-action" bindtap="addIngredient">
          <van-icon name="plus" size="14px" />加个食材
        </text>
      </view>

      <block wx:for="{{formData.ingredients}}" wx:key="id">
        <view class="ingredient-item">
          <van-field
            value="{{item.name}}"
            placeholder="食材"
            maxlength="15"
            data-index="{{index}}"
            bind:input="onIngredientNameInput"
            class="ingredient-name-field"
          />
          <van-field
            value="{{item.amount}}"
            placeholder="用量"
            maxlength="10"
            data-index="{{index}}"
            bind:input="onIngredientAmountInput"
            class="ingredient-amount-field"
          />
          <van-icon 
            wx:if="{{formData.ingredients.length > 1}}"
            name="delete" 
            size="18px" 
            color="#ff4444" 
            bindtap="removeIngredient" 
            data-index="{{index}}"
            class="delete-icon"
          />
        </view>
      </block>

      <view class="ingredient-extra-group">
        <text class="input-label">配料（可选）</text>
        <van-field
          value="{{formData.sideIngredients}}"
          placeholder="例如：葱花、姜片、蒜末，可用顿号分隔"
          type="textarea"
          autosize
          maxlength="100"
          show-word-limit
          bind:change="onSideIngredientsChange"
        />
      </view>

      <view class="ingredient-extra-group">
        <text class="input-label">调料（可选）</text>
        <van-field
          value="{{formData.seasonings}}"
          placeholder="例如：生抽、盐、白糖，可用顿号分隔"
          type="textarea"
          autosize
          maxlength="100"
          show-word-limit
          bind:change="onSeasoningsChange"
        />
      </view>
    </view>

    <!-- 投喂步骤 -->
    <view class="form-section {{filledFlash ? 'just-filled' : ''}}">
      <view class="section-header">
        <text class="section-label {{stepRequiredClass}}">投喂步骤{{optionalSuffix}}</text>
        <text class="section-action" bindtap="addStep">
          <van-icon name="plus" size="14px" />加一步
        </text>
      </view>

      <block wx:for="{{formData.steps}}" wx:key="id">
        <view class="step-item">
          <view class="step-header">
            <view class="step-number">{{index + 1}}</view>
            <van-icon
              wx:if="{{formData.steps.length > 1}}"
              name="delete"
              size="18px"
              color="#ff4444"
              bindtap="removeStep"
              data-index="{{index}}"
            />
          </view>
          
          <view class="step-content">
            <van-field
              value="{{item.content}}"
              placeholder="写下这一步怎么做..."
              type="textarea"
              autosize
              maxlength="200"
              show-word-limit
              data-index="{{index}}"
              bind:change="onStepContentChange"
              class="step-textarea"
            />

            <!-- 步骤图片 -->
            <view class="step-image-section">
              <block wx:if="{{item.image}}">
                <view class="step-image-item">
                  <cloud-image class="step-uploaded-image" custom-class="step-uploaded-image" src="{{item.image}}" fallback="/images/default-recipe.jpg" />
                  <view class="step-image-delete" bindtap="removeStepImage" data-index="{{index}}">
                    <van-icon name="cross" size="12px" color="#fff" />
                  </view>
                </view>
              </block>
              
              <text 
                wx:else
                class="step-image-upload"
                bindtap="onStepImageUpload"
                data-index="{{index}}"
              >
                <van-icon name="photograph" size="16px" />加张步骤图
              </text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 小红书链接 -->
    <view class="form-section">
      <view class="input-group">
        <text class="input-label">小红书灵感（可选）</text>
        <van-field
          value="{{formData.xiaohongshuUrl}}"
          placeholder="粘贴灵感笔记链接"
          maxlength="200"
          show-word-limit
          bind:change="onXiaohongshuUrlChange"
        />
      </view>
    </view>

    <!-- 分享设置 -->
    <view wx:if="{{showRecipePrivacy}}" class="form-section">
      <view class="privacy-setting">
        <view class="privacy-info">
          <view class="privacy-title">公开展示</view>
          <view class="privacy-desc">关闭后仅自己和已绑定的饭搭子可见</view>
        </view>
        <van-switch 
          checked="{{formData.isPublic}}" 
          size="24px"
          bind:change="onPrivacyChange"
        />
      </view>
    </view>

    <!-- 底部占位 -->
    <view class="bottom-placeholder"></view>
  </scroll-view>

  <!-- AI 填表悬浮入口，可拖动 -->
  <view
    wx:if="{{showTemplateEntry}}"
    class="ai-fab {{fabDragging ? 'dragging' : ''}}"
    style="left: {{fabLeft}}px; top: {{fabTop}}px;"
    catchtouchstart="onFabTouchStart"
    catchtouchmove="onFabTouchMove"
    catchtouchend="onFabTouchEnd"
  >
    <text class="ai-fab-icon">🤖</text>
  </view>

  <!-- 底部按钮 -->
  <view class="footer {{footerClass}}">
    <van-button
      wx:if="{{!isWishMode && showDraftAction}}"
      type="default"
      class="draft-btn"
      bind:click="onSave"
      loading="{{loading}}"
      round
      block
      custom-style="height: 88rpx; border-radius: 999rpx; color: #8C7770; background: #F5ECE6; border: 1rpx solid #E8DED8; font-weight: 600;"
    >
      {{draftText}}
    </van-button>
    <van-button 
      type="primary"
      class="submit-btn"
      bind:click="onSubmit"
      loading="{{loading}}"
      color="linear-gradient(135deg, #E85D4A, #D94A3A)"
      round
      block
      custom-style="height: 88rpx; border-radius: 999rpx; font-weight: 600; box-shadow: 0 10rpx 24rpx rgba(232, 93, 74, 0.28);"
    >
      {{submitText}}
    </van-button>
  </view>
</view>
<theme-confirm-dialog id="themeConfirmDialog" />
<global-notification-popup id="globalNotificationPopup" />
