<view class="notification-page">
  <login-prompt id="loginPrompt" />
  <view wx:if="{{loading}}" class="state">
    <text>消息加载中...</text>
  </view>

  <view wx:elif="{{notifications.length === 0}}" class="state empty">
    <text class="empty-icon">🔔</text>
    <text class="empty-title">还没有新消息</text>
    <text class="empty-desc">投喂动态、饭愿和祝福都会记录在这里</text>
  </view>

  <view wx:else class="notification-list">
    <view class="message-summary">
      <view class="summary-icon">🔔</view>
      <view class="summary-copy">
        <text class="summary-title">饭搭子的暖心动态</text>
        <text class="summary-desc">{{unreadCount ? '还有 ' + unreadCount + ' 条消息等你查看' : '消息都看完啦，记得回应 TA'}}</text>
      </view>
      <button
        wx:if="{{unreadCount}}"
        class="mark-all-button"
        loading="{{markingAllRead}}"
        disabled="{{markingAllRead}}"
        bindtap="markAllRead"
      >{{markingAllRead ? '处理中' : '全部已读'}}</button>
      <view wx:else class="all-read-badge">✓</view>
    </view>

    <view
      wx:for="{{notifications}}"
      wx:key="_id"
      class="notification-swipe-item"
    >
      <view wx:if="{{item.swipeOffset < 0}}" class="notification-delete-action" data-id="{{item._id}}" catchtap="onDeleteNotification">删除</view>
      <view
      class="notification-card {{item.read ? 'read' : 'unread'}}"
      style="transform: translateX({{item.swipeOffset || 0}}px);"
      data-id="{{item._id}}"
      data-page="{{item.targetPage}}"
      bindtap="openNotification"
      bindtouchstart="onNotificationTouchStart"
      bindtouchmove="onNotificationTouchMove"
      bindtouchend="onNotificationTouchEnd"
      bindtouchcancel="onNotificationTouchEnd"
    >
      <view class="notification-icon {{item.themeClass}}">
        <text>{{item.icon}}</text>
        <view wx:if="{{!item.read}}" class="icon-dot"></view>
      </view>
      <view class="notification-main">
        <view class="notification-head">
          <text class="type-label {{item.themeClass}}">{{item.typeLabel}}</text>
          <text wx:if="{{!item.read}}" class="unread-label">新消息</text>
        </view>
        <text class="notification-title">{{item.title}}</text>
        <text class="notification-content">{{item.content}}</text>
        <view class="notification-footer">
          <text class="notification-time">{{item.displayTime}}</text>
          <text class="notification-action">查看详情 <text class="action-arrow">›</text></text>
        </view>
      </view>
    </view>
    </view>
    <view wx:if="{{loadingMore}}" class="state"><text>继续加载中...</text></view>
    <view wx:elif="{{!hasMore && notifications.length > 0}}" class="state"><text>已经到底啦</text></view>
  </view>
</view>
