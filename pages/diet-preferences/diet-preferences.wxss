.preferences-page { min-height: 100vh; padding: 24rpx 28rpx 60rpx; box-sizing: border-box; color: #3F302B; background: #FFF9ED; }.preferences-hero { padding: 32rpx; color: #FFF; border-radius: 24rpx; background: linear-gradient(135deg, #E85D4A, #D94A3A); }.hero-title,.hero-desc { display:block; }.hero-title { font-size:36rpx; font-weight:700; }.hero-desc { margin-top:8rpx; color:rgba(255,255,255,.82); font-size:22rpx; }.section { margin-top:20rpx; padding:24rpx; border-radius:18rpx; background:#FFF; }.section-title { display:block; margin-bottom:16rpx; font-size:25rpx; font-weight:600; }.options { display:flex; flex-wrap:wrap; gap:14rpx; }.option { padding:14rpx 24rpx; color:#8C7770; font-size:23rpx; border-radius:24rpx; background:#F3EAE4; }.option.active { color:#FFF; background:#E85D4A; }.text-input { height:74rpx; padding:0 20rpx; box-sizing:border-box; color:#3F302B; font-size:23rpx; border:1rpx solid #EEDFD6; border-radius:12rpx; background:#FFFCF8; }.save-button { margin-top:28rpx; color:#FFF; font-size:27rpx; border-radius:16rpx; background:#E85D4A; }.state { padding:140rpx 0; color:#9A8780; text-align:center; }
