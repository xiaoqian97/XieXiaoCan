/* 页面容器 */
.recipe-list-container {
  min-height: 100vh;
  background-color: #FFF9ED;
  padding-top: 120rpx; /* 为固定头部留出空间 */
  padding-bottom: 120rpx;
}

/* 头部区域 */
.header-section {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 24rpx 32rpx;
  /* border-bottom: 1rpx solid #F5ECE6; */
  z-index: 1000;
}

.header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-wrapper {
  flex: 1;
}

.add-btn {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #E85D4A, #D94A3A);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(59, 130, 246, 0.3);
}

/* 场景分类区域 */
.scene-section {
  background-color: #ffffff;
  padding: 10rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #F5ECE6;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8C7770;
}

.scene-grid {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
}

.scene-tag {
  display: flex;
  /* flex-direction: column; */
  justify-content: center;
  align-items: center;
  padding: 10rpx 8rpx;
  border-radius: 16rpx;
  text-align: center;
  transition: all 0.3s ease;
  color: #ffffff;
}

.scene-tag-daily {
  background: linear-gradient(135deg, #E85D4A, #D94A3A);
}

.scene-tag-quick {
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
}

.scene-tag-guest {
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
}

.scene-tag-light {
  background: linear-gradient(135deg, #06b6d4, #0891b2);
}

.scene-tag-heavy {
  background: linear-gradient(135deg, #dc2626, #b91c1c);
}

.scene-tag.active {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.3);
}

.scene-emoji {
  font-size: 28rpx;
  margin-bottom: 4rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
  filter: drop-shadow(0 1rpx 1rpx rgba(0, 0, 0, 0.1));
}

.scene-name {
  font-size: 20rpx;
  font-weight: 500;
}

/* 食材筛选区域 */
.ingredient-section {
  background-color: #ffffff;
  padding: 16rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #F5ECE6;
}

.more-filter-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.more-filter-text {
  font-size: 22rpx;
  color: #E85D4A;
}

.ingredient-scroll {
  white-space: nowrap;
}

.ingredient-list {
  display: inline-flex;
  gap: 12rpx;
  padding-top: 10rpx;
}

.ingredient-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background-color: #18c289;
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 22rpx;
  white-space: nowrap;
  opacity: 0.7;
  transition: all 0.3s ease;
}

.ingredient-tag.selected {
  opacity: 1;
  transform: translateY(-1rpx);
  box-shadow: 0 2rpx 8rpx rgba(16, 185, 129, 0.3);
}

.ingredient-emoji {
  font-size: 24rpx;
}

.ingredient-name {
  font-size: 20rpx;
  font-weight: 500;
}

/* 高级筛选面板 */
.advanced-filter-panel {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F5ECE6;
}

.advanced-filter-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.filter-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.filter-group-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #8C7770;
}

.filter-options {
  display: flex;
  gap: 12rpx;
}

.filter-option {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background-color: #F5ECE6;
  border-radius: 20rpx;
  font-size: 20rpx;
  color: #8C7770;
  transition: all 0.3s ease;
}

.filter-option.selected {
  background-color: #E85D4A;
  color: #ffffff;
}

.option-emoji {
  font-size: 22rpx;
}

.option-text {
  font-size: 20rpx;
  font-weight: 500;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.filter-tag {
  padding: 8rpx 16rpx;
  background-color: #6c757d;
  border: 2rpx solid #495057;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 500;
  transition: all 0.3s ease;
}

.filter-tag.selected {
  background-color: #007bff;
  border-color: #0056b3;
  color: #ffffff;
  font-weight: 600;
}

/* 当前筛选条件显示 */
.current-filters {
  background-color: #FFF4E8;
  padding: 12rpx 32rpx;
}

.current-filters-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.current-filters-label {
  font-size: 22rpx;
  color: #E85D4A;
}

.current-filter-tags {
  display: flex;
  gap: 8rpx;
}

.current-filter-tag {
  padding: 4rpx 12rpx;
  background-color: #FFF1D6;
  border-radius: 12rpx;
  font-size: 20rpx;
  color: #E85D4A;
}

.clear-filters-btn {
  font-size: 20rpx;
  color: #E85D4A;
  margin-left: auto;
}

/* 已选筛选条件 */
.selected-filters {
  background-color: #ffffff;
  padding: 16rpx 32rpx;
  border-top: 1rpx solid #F5ECE6;
}

.selected-filters-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.selected-filters-label {
  font-size: 22rpx;
  color: #E85D4A;
  font-weight: 500;
}

.reset-filters-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background-color: #FFF4E8;
  border: 1rpx solid #E85D4A;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.reset-filters-btn:active {
  background-color: #FFF1D6;
  transform: scale(0.95);
}

.reset-text {
  font-size: 20rpx;
  color: #E85D4A;
  font-weight: 500;
}

.selected-filters-scroll {
  white-space: nowrap;
}

.selected-filters-list {
  display: inline-flex;
  gap: 12rpx;
}

.selected-filter-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  background-color: #FFF1D6;
  border: 1rpx solid #0891b2;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #0891b2;
  white-space: nowrap;
}

.selected-filter-item.quick-filter {
  background-color: #FFF1D6;
  border-color: #E85D4A;
  color: #E85D4A;
}

.selected-filter-item.scene-filter {
  background-color: #f3e8ff;
  border-color: #8b5cf6;
  color: #8b5cf6;
}

.selected-filter-item.ingredient-filter {
  background-color: #dcfce7;
  border-color: #10b981;
  color: #10b981;
}

.selected-filter-item.optional-tag-filter {
  background-color: #fef3c7;
  border-color: #f59e0b;
  color: #f59e0b;
}

.selected-filter-item.time-filter {
  background-color: #FFF1D6;
  border-color: #0891b2;
  color: #0891b2;
}

/* 菜谱列表 */
.recipe-list {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.recipe-card {
  position: relative;
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  margin-bottom: 24rpx;
}

.recipe-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.recipe-content {
  display: flex;
  padding: 32rpx;
  gap: 32rpx;
  align-items: flex-start;
}

.recipe-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  object-fit: cover;
  flex-shrink: 0;
}

.recipe-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-height: 200rpx;
  justify-content: space-between;
}

.recipe-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #3F302B;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.recipe-description {
  font-size: 26rpx;
  color: #8C7770;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.recipe-description-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-word;
}

.recipe-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #8C7770;
}

.recipe-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-top: auto;
  align-items: center;
  justify-content: space-between;
  line-height: 1;
}

.recipe-tag {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  flex-shrink: 0;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 60rpx;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.recipe-tag.scene-tag {
  background: linear-gradient(135deg, #E85D4A, #1d4ed8);
  box-shadow: 0 2rpx 8rpx rgba(59, 130, 246, 0.3);
}

.recipe-tag.ingredient-tag {
  background: linear-gradient(135deg, #10b981, #047857);
  box-shadow: 0 2rpx 8rpx rgba(16, 185, 129, 0.3);
}

.recipe-tag.optional-tag {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.3);
}

.recipe-tag.more-tag {
  background: linear-gradient(135deg, #8C7770, #6E5852);
  font-size: 20rpx;
  padding: 8rpx 12rpx;
  min-width: 50rpx;
  max-width: 80rpx;
}

/* 状态页面 */
.loading-state,
.load-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
  gap: 16rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #8C7770;
}

.load-more {
  flex-direction: row;
  padding: 40rpx 32rpx;
  font-size: 26rpx;
  color: #8C7770;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3F302B;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8C7770;
  margin-bottom: 48rpx;
  line-height: 1.5;
}

.no-more {
  text-align: center;
  padding: 40rpx 32rpx;
  font-size: 26rpx;
  color: #A9958E;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  bottom: 200rpx;
  right: 40rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #E85D4A, #D94A3A);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.4);
  z-index: 100;
  transition: all 0.3s ease;
}

.fab:active {
  transform: scale(0.95);
}

/* Vant组件样式重置 */
.van-field {
  background-color: #F5ECE6 !important;
  border-radius: 16rpx !important;
  border: none !important;
}

.van-field__control {
  font-size: 26rpx !important;
  color: #3F302B !important;
}

.van-field__placeholder {
  color: #A9958E !important;
}

/* 响应式适配 */
@media (max-width: 375px) {
  .scene-grid {
    grid-template-columns: repeat(4, 1fr);
  }
  
  .scene-emoji {
    font-size: 24rpx;
  }
  
  .scene-name {
    font-size: 18rpx;
  }
}

/* 安全区域适配 */
.recipe-list-container {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom, 0));
}

/* 状态筛选器 */
.status-filter-section {
  background-color: #ffffff;
  padding: 20rpx 32rpx 16rpx 32rpx;
  border-bottom: 1rpx solid #F5ECE6;
}

.status-filter-tabs {
  display: flex;
  gap: 90rpx;
  justify-content: center;
  align-items: center;
}

.status-tab {
  position: relative;
  padding: 8rpx 0;
  cursor: pointer;
  transition: all 0.2s ease;
}

.status-tab.active .status-name {
  color: #1890ff;
  font-weight: 600;
}

.status-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 3rpx;
  background-color: #1890ff;
  border-radius: 2rpx;
}

.status-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #8C7770;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.status-count {
  font-size: 22rpx;
  margin-left: 6rpx;
  opacity: 0.7;
  color: inherit;
}

/* 菜谱状态标签 */
.recipe-status-tag {
  position: absolute;
  top: 0;
  right: 0;
  padding: 8rpx 16rpx 8rpx 20rpx;
  border-radius: 0 0 0 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  z-index: 10;
  color: #ffffff;
  min-width: 50rpx;
  text-align: center;
  letter-spacing: 0.5rpx;
}

.recipe-status-tag.draft {
  background-color: #f59e0b;
}

.recipe-status-tag.published {
  background-color: #10b981;
}

.status-text {
  font-size: 22rpx;
  font-weight: 600;
}

.favorite-modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(51, 38, 34, 0.48);
}

.favorite-modal {
  width: 100%;
  max-width: 640rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 24rpx 64rpx rgba(63, 48, 43, 0.2);
}

.favorite-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.favorite-modal-heading,
.favorite-modal-title,
.favorite-modal-count,
.favorite-modal-limit {
  display: block;
}

.favorite-modal-title {
  color: #3F302B;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.favorite-modal-count {
  margin-top: 8rpx;
  color: #A9958E;
  font-size: 23rpx;
}

.favorite-modal-close {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F5ECE6;
  color: #8C7770;
  font-size: 38rpx;
  line-height: 1;
}

.favorite-user-scroll {
  max-height: 520rpx;
  margin-top: 30rpx;
}

.favorite-user-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.favorite-user-pill {
  display: inline-flex;
  max-width: 100%;
  height: 64rpx;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 18rpx 6rpx 8rpx;
  box-sizing: border-box;
  border: 1rpx solid #F1DED5;
  border-radius: 32rpx;
  background: #FFF8F3;
}

.favorite-user-avatar {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #F5ECE6;
}

.favorite-user-name {
  max-width: 220rpx;
  overflow: hidden;
  color: #5E4942;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.viewer-user-pill {
  padding-right: 12rpx;
}

.viewer-user-count {
  flex-shrink: 0;
  padding: 3rpx 10rpx;
  border-radius: 18rpx;
  background: #F5ECE6;
  color: #A06B5C;
  font-size: 20rpx;
}

.favorite-modal-limit {
  margin-top: 22rpx;
  color: #A9958E;
  font-size: 22rpx;
  text-align: center;
}

.favorite-modal-confirm {
  height: 76rpx;
  margin-top: 28rpx;
  border-radius: 38rpx;
  background: #E85D4A;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.favorite-modal-confirm::after {
  border: none;
}
