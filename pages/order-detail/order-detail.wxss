/* 订单详情页面样式 */
.order-detail-container {
  min-height: 100vh;
  background-color: #FFF9ED;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #8C7770;
}

/* 订单内容 */
.order-content {
  padding: 32rpx;
}

/* 订单头部 */
.order-header {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.order-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.meal-icon {
  font-size: 32rpx;
}

.meal-type {
  font-size: 36rpx;
  font-weight: 600;
  color: #3F302B;
}

.status-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-pending {
  background-color: #fef3c7;
  color: #f59e0b;
}

.status-processing {
  background-color: #FFF1D6;
  color: #E85D4A;
}

.status-completed {
  background-color: #d1fae5;
  color: #10b981;
}

.status-cancelled {
  background-color: #fee2e2;
  color: #ef4444;
}

.order-no {
  font-size: 24rpx;
  color: #8C7770;
}

/* 订单信息 */
.order-info {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5ECE6;
}

.rating-info {
  align-items: flex-start;
}

.rating-value {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.rating-score {
  color: #f59e0b;
  font-weight: 600;
}

.rating-content {
  color: #8C7770;
  font-size: 24rpx;
  text-align: right;
}

.dish-rating {
  color: #f59e0b;
  font-weight: 600;
}

.rating-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.45);
}

.rating-modal {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  padding: 40rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0;
  background: #fff;
}

.memory-modal {
  width: 100%;
  padding: 48rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0;
  background: #fff;
}

.memory-modal-desc {
  display: block;
  margin: 20rpx 8rpx 24rpx;
  color: #8C7770;
  font-size: 26rpx;
  line-height: 1.6;
}

.rating-title {
  display: block;
  color: #3F302B;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
}

.rating-stars {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}

.rating-star {
  color: #E8DED8;
  font-size: 48rpx;
  line-height: 1;
}

.rating-star.active {
  color: #f59e0b;
}

.rating-recipe-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 32rpx 0;
}

.rating-recipe-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #FFF9ED;
}

.rating-recipe-image {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
}

.rating-recipe-content {
  min-width: 0;
  flex: 1;
}

.rating-recipe-name {
  display: block;
  overflow: hidden;
  color: #3F302B;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rating-recipe-score {
  flex-shrink: 0;
  color: #E85D4A;
  font-size: 24rpx;
  font-weight: 600;
}

.rating-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #FFF9ED;
  color: #6E5852;
  font-size: 28rpx;
}

.rating-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.rating-button {
  flex: 1;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.rating-button::after {
  border: none;
}

.rating-button.cancel {
  background: #F5ECE6;
  color: #8C7770;
}

.rating-button.confirm {
  background: #22c55e;
  color: #fff;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #8C7770;
  min-width: 120rpx;
}

.info-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #3F302B;
  flex: 1;
  justify-content: flex-end;
}

.assignee-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
}

.assignee-name {
  font-weight: 500;
}

.notes {
  text-align: right;
  color: #8C7770;
  font-size: 24rpx;
}

/* 菜品列表 */
.recipes-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3F302B;
  margin-bottom: 24rpx;
}

.recipes-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recipe-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #FFF9ED;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.recipe-item:active {
  background-color: #E8DED8;
  transform: scale(0.98);
}

.recipe-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.recipe-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.recipe-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #3F302B;
}

.recipe-meta {
  display: flex;
  gap: 16rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #8C7770;
}

/* 操作按钮 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E8DED8;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.button-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.button-group  view{
  flex: 1;
}


/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 120rpx 32rpx;
}

.error-emoji {
  font-size: 80rpx;
}

.error-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3F302B;
}

.error-desc {
  font-size: 28rpx;
  color: #8C7770;
  text-align: center;
}

