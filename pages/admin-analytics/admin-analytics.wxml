<view class="analytics-page">
  <view class="dashboard-head">
    <view>
      <text class="head-title">运营数据</text>
      <text class="head-desc">仅主管理员可见</text>
    </view>
    <text class="head-mark">▥</text>
  </view>

  <view class="range-tabs">
    <view wx:for="{{ranges}}" wx:key="value" class="range-tab {{days === item.value ? 'active' : ''}}" data-days="{{item.value}}" bindtap="changeRange">{{item.label}}</view>
  </view>

  <view class="overview-grid">
    <view class="overview-item"><text class="overview-value">{{overview.activeUsers}}</text><text class="overview-label">活跃用户</text></view>
    <view class="overview-item"><text class="overview-value">{{overview.totalSessions}}</text><text class="overview-label">进入次数</text></view>
    <view class="overview-item"><text class="overview-value small">{{overview.totalDurationText}}</text><text class="overview-label">累计时长</text></view>
    <view class="overview-item"><text class="overview-value small">{{overview.averageText}}</text><text class="overview-label">平均停留</text></view>
  </view>

  <view class="section" wx:if="{{trend.length}}">
    <view class="section-title">访问趋势</view>
    <view class="trend-row" wx:for="{{trend}}" wx:key="date">
      <text class="trend-date">{{item.dateLabel}}</text>
      <view class="trend-track"><view class="trend-bar" style="width: {{item.width}}%;"></view></view>
      <text class="trend-count">{{item.sessions}}次</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">常用功能</view>
    <view wx:if="{{!features.length}}" class="empty-inline">暂无功能使用数据</view>
    <view class="feature-row" wx:for="{{features}}" wx:key="name">
      <view class="feature-info"><text>{{index + 1}}. {{item.label}}</text><text>{{item.count}}次</text></view>
      <view class="feature-track"><view class="feature-bar" style="width: {{item.width}}%;"></view></view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">用户活跃明细</view>
    <view wx:if="{{!users.length}}" class="empty-inline">当前周期暂无活跃用户</view>
    <view class="user-card" wx:for="{{users}}" wx:key="userId">
      <image class="avatar" src="{{item.avatar}}" mode="aspectFill" />
      <view class="user-main">
        <view class="user-name-line"><text class="user-name">{{item.nickname}}</text><text class="role-tag">{{item.roleLabel}}</text></view>
        <text class="user-sub">进入 {{item.sessionCount}} 次 · 累计 {{item.durationText}} · 平均 {{item.averageText}}</text>
        <text class="user-sub">活跃 {{item.activeDays}} 天 · 最近 {{item.lastVisitText}}</text>
        <text class="user-feature">常用：{{item.topFeatureText}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">投喂官菜谱运营</view>
    <view wx:if="{{!chefs.length}}" class="empty-inline">暂无投喂官数据</view>
    <view class="chef-card" wx:for="{{chefs}}" wx:key="openid">
      <view class="chef-head" data-openid="{{item.openid}}" bindtap="toggleChef">
        <image class="avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view class="chef-name-wrap"><text class="user-name">{{item.nickname}}</text><text class="user-sub">最近添加：{{item.latestRecipeText}}</text></view>
        <text class="expand-icon">{{expandedChef === item.openid ? '⌃' : '⌄'}}</text>
      </view>
      <view class="chef-metrics">
        <view><text>{{item.publishedCount}}</text><text>发布</text></view>
        <view><text>{{item.draftCount}}</text><text>草稿</text></view>
        <view><text>{{item.viewCount}}</text><text>查看</text></view>
        <view><text>{{item.favoriteCount}}</text><text>收藏</text></view>
        <view><text>{{item.salesCount}}</text><text>下单</text></view>
        <view><text>{{item.ratingAverage || '-'}}</text><text>评分</text></view>
      </view>
      <view wx:if="{{expandedChef === item.openid}}" class="recipe-list">
        <view wx:if="{{!item.recipes.length}}" class="empty-inline">该投喂官还没有菜谱</view>
        <view class="recipe-row" wx:for="{{item.recipes}}" wx:key="_id" wx:for-item="recipe">
          <image class="recipe-image" src="{{recipe.displayImage}}" mode="aspectFill" />
          <view class="recipe-body">
            <view class="recipe-title"><text>{{recipe.name}}</text><text class="status-tag {{recipe.status}}">{{recipe.statusLabel}}</text></view>
            <text class="recipe-stats">查看 {{recipe.viewCount}} · 收藏 {{recipe.favoriteCount}} · 下单 {{recipe.salesCount}} · 评分 {{recipe.ratingAverage || '-'}}</text>
          </view>
          <view class="recipe-view-button" data-id="{{recipe._id}}" bindtap="openRecipeDetail">查看</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">正在汇总数据...</view>
</view>
<global-notification-popup id="globalNotificationPopup" />
