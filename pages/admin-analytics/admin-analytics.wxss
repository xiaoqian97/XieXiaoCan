.analytics-page { min-height: 100vh; padding: 24rpx 28rpx calc(60rpx + env(safe-area-inset-bottom)); box-sizing: border-box; color: #3F302B; background: #FFF9ED; }
.dashboard-head { display: flex; align-items: center; justify-content: space-between; padding: 30rpx 32rpx; border-radius: 24rpx; color: #FFFFFF; background: #E85D4A; box-shadow: 0 10rpx 26rpx rgba(232, 93, 74, .18); }
.head-title, .head-desc { display: block; }
.head-title { font-size: 36rpx; font-weight: 700; }
.head-desc { margin-top: 7rpx; color: rgba(255,255,255,.78); font-size: 22rpx; }
.head-mark { font-size: 54rpx; }
.range-tabs { display: flex; margin: 24rpx 0; padding: 6rpx; border-radius: 16rpx; background: #F1E7DF; }
.range-tab { flex: 1; height: 58rpx; color: #8C7770; font-size: 21rpx; line-height: 58rpx; text-align: center; border-radius: 12rpx; }
.range-tab.active { color: #FFFFFF; font-weight: 600; background: #E85D4A; }
.overview-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.overview-item { display: flex; min-height: 124rpx; flex-direction: column; justify-content: center; padding: 20rpx 24rpx; box-sizing: border-box; border: 1rpx solid #F2E5DC; border-radius: 20rpx; background: #FFFFFF; }
.overview-value { color: #E85D4A; font-size: 42rpx; font-weight: 700; }
.overview-value.small { font-size: 32rpx; }
.overview-label { margin-top: 6rpx; color: #8C7770; font-size: 22rpx; }
.section { margin-top: 26rpx; padding: 26rpx; border-radius: 22rpx; background: #FFFFFF; box-shadow: 0 5rpx 16rpx rgba(63,48,43,.05); }
.section-title { margin-bottom: 22rpx; font-size: 28rpx; font-weight: 700; }
.trend-row { display: flex; align-items: center; gap: 14rpx; margin: 13rpx 0; }
.trend-date { width: 74rpx; color: #8C7770; font-size: 20rpx; }
.trend-track, .feature-track { flex: 1; height: 14rpx; overflow: hidden; border-radius: 7rpx; background: #F4ECE7; }
.trend-bar, .feature-bar { height: 100%; border-radius: 7rpx; background: #F6C85F; }
.trend-count { width: 64rpx; color: #8C7770; font-size: 20rpx; text-align: right; }
.feature-row { margin: 18rpx 0; }
.feature-info { display: flex; justify-content: space-between; margin-bottom: 8rpx; font-size: 23rpx; }
.feature-bar { background: #E85D4A; }
.user-card { display: flex; gap: 18rpx; padding: 22rpx 0; border-bottom: 1rpx solid #F2E8E2; }
.user-card:last-child { border-bottom: 0; }
.avatar { width: 78rpx; height: 78rpx; flex-shrink: 0; border-radius: 50%; background: #F4ECE7; }
.user-main, .chef-name-wrap { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 7rpx; }
.user-name-line { display: flex; align-items: center; gap: 10rpx; }
.user-name { overflow: hidden; font-size: 27rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.role-tag, .status-tag { padding: 3rpx 10rpx; color: #B14B3D; font-size: 18rpx; border-radius: 8rpx; background: #FFF0EB; }
.user-sub { color: #8C7770; font-size: 20rpx; line-height: 1.5; }
.user-feature { color: #9A6018; font-size: 20rpx; }
.chef-card { margin-bottom: 18rpx; overflow: hidden; border: 1rpx solid #F0E2D9; border-radius: 18rpx; }
.chef-head { display: flex; align-items: center; gap: 16rpx; padding: 20rpx; }
.expand-icon { color: #B49D93; font-size: 30rpx; }
.chef-metrics { display: grid; grid-template-columns: repeat(6, 1fr); padding: 16rpx 8rpx; border-top: 1rpx solid #F2E8E2; background: #FFFCF8; }
.chef-metrics view { display: flex; align-items: center; flex-direction: column; gap: 5rpx; }
.chef-metrics text:first-child { color: #E85D4A; font-size: 25rpx; font-weight: 700; }
.chef-metrics text:last-child { color: #9A8780; font-size: 17rpx; }
.recipe-list { padding: 0 20rpx 12rpx; border-top: 1rpx solid #F2E8E2; }
.recipe-row { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 0; border-bottom: 1rpx solid #F5ECE7; }
.recipe-row:last-child { border-bottom: 0; }
.recipe-image { width: 92rpx; height: 92rpx; flex-shrink: 0; border-radius: 12rpx; background: #F4ECE7; }
.recipe-body { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 8rpx; }
.recipe-title { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; font-size: 23rpx; font-weight: 600; }
.recipe-title > text:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.status-tag.draft { color: #7F716B; background: #F0ECE9; }
.recipe-stats { display: block; margin-top: 9rpx; color: #8C7770; font-size: 19rpx; }
.recipe-view-button { flex-shrink: 0; padding: 10rpx 16rpx; color: #E85D4A; font-size: 21rpx; font-weight: 600; border: 1rpx solid #F4B5A9; border-radius: 12rpx; }
.empty-inline, .loading { padding: 24rpx 0; color: #9B8780; font-size: 22rpx; text-align: center; }
.loading { position: fixed; right: 0; bottom: 40rpx; left: 0; }
