.detail-page { min-height:100vh;padding:42rpx 28rpx calc(60rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#FFF9ED;color:#3F302B; }.detail-state { display:flex;min-height:600rpx;align-items:center;justify-content:center;color:#A9958E;font-size:25rpx; }.detail-card { position:relative;overflow:hidden;min-height:620rpx;padding:66rpx 48rpx 52rpx;box-sizing:border-box;border:1rpx solid rgba(255,255,255,.85);border-radius:38rpx;background:linear-gradient(145deg,#FFE9B2,#FFD8D0);box-shadow:0 18rpx 45rpx rgba(78,48,38,.14);text-align:center; }.detail-orb { position:absolute;border-radius:50%;background:rgba(255,255,255,.28); }.orb-left { width:260rpx;height:260rpx;top:-130rpx;left:-90rpx; }.orb-right { width:200rpx;height:200rpx;right:-90rpx;bottom:-100rpx; }.detail-emoji,.detail-kicker,.detail-title,.detail-content,.detail-sign { position:relative;z-index:1;display:block; }.detail-emoji { font-size:78rpx; }.detail-kicker { margin-top:22rpx;color:#9A6E60;font-size:22rpx;letter-spacing:2rpx; }.detail-title { margin-top:22rpx;color:#3F302B;font-size:42rpx;font-weight:800;line-height:1.4; }.detail-content { margin-top:28rpx;color:#654F48;font-size:28rpx;line-height:1.9; }.rich-content { text-align:left;word-break:break-word; }.detail-divider { position:relative;z-index:1;display:flex;margin:42rpx 0 28rpx;align-items:center;color:#E85D4A;font-size:21rpx; }.detail-divider::before,.detail-divider::after { content:'';height:1rpx;flex:1;background:rgba(142,97,80,.25); }.detail-divider text { margin:0 18rpx; }.detail-sign { color:#966E61;font-size:22rpx; }.detail-meta { margin-top:24rpx;padding:24rpx 28rpx;border-radius:26rpx;background:#fff;box-shadow:0 6rpx 18rpx rgba(63,48,43,.05); }.meta-row { display:flex;padding:11rpx 0;align-items:center;justify-content:space-between;color:#8C7770;font-size:23rpx; }.meta-row .status { color:#D94A3A;font-weight:600; }.wechat-note { margin-top:12rpx;padding:16rpx;color:#9A8178;font-size:20rpx;line-height:1.5;border-radius:16rpx;background:#FFF7EF; }.cancel-button,.again-button { height:84rpx;margin:28rpx 0 0;font-size:27rpx;font-weight:600;line-height:84rpx;border-radius:42rpx; }.cancel-button { color:#D94A3A;background:#FFF;border:1rpx solid #F1DAD2; }.again-button { color:#fff;background:linear-gradient(135deg,#F06B55,#E5473B);box-shadow:0 10rpx 22rpx rgba(232,93,74,.22); }.cancel-button::after,.again-button::after { border:0; }
.theme-night { background:linear-gradient(145deg,#E8E4FF,#C9D7FF); }.theme-morning { background:linear-gradient(145deg,#FFF1B6,#FFDFA0); }.theme-anniversary,.theme-missing-you { background:linear-gradient(145deg,#FFE6EC,#FFCFCF); }.theme-birthday { background:linear-gradient(145deg,#E5F9EF,#D8EEFF); }.theme-eat-well,.theme-waiting-home,.theme-warm-hug { background:linear-gradient(145deg,#FFF0D2,#FFDCC5); }
.theme-new-year { background:linear-gradient(145deg,#FFE8B0,#FFBE66); }.theme-valentine { background:linear-gradient(145deg,#FFE5EC,#FFAFC2); }.theme-spring { background:linear-gradient(145deg,#FFD8C5,#F79B85); }.theme-labor { background:linear-gradient(145deg,#FFF0A9,#CFE7A9); }.theme-children { background:linear-gradient(145deg,#DDF5FF,#FFD8E9); }.theme-qixi { background:linear-gradient(145deg,#E2DEFF,#AFB8F1); }.theme-mid-autumn { background:linear-gradient(145deg,#DFE9FF,#FFE9A9); }.theme-national { background:linear-gradient(145deg,#FFD9B8,#F4C75E); }
