/* 全屏页面容器 */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F6C85F 0%, #FFF0C2 30%, #FFF9ED 100%);
  padding: env(safe-area-inset-top) 32rpx calc(140rpx + env(safe-area-inset-bottom, 0)) 32rpx;
  box-sizing: border-box;
}

/* 移除了状态栏样式 */

.iconfont {
  font-family: "iconfont" !important;
  font-size: 28rpx;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
}

/* 头部用户信息 */
.header-section {
  padding: 62rpx 0 32rpx 0;
}

.user-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 48rpx;
}

.greeting-text {
  display: block;
  font-size: 46rpx;
  font-weight: 800;
  color: #3F302B;
  margin-top: 30rpx;
  margin-bottom: 8rpx;
}

.sub-text {
  font-size: 28rpx;
  color: #6E5852;
}

/* 搜索框 */
.search-container {
  position: relative;
  margin-bottom: 48rpx;
}

.search-icon {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #A9958E;
  font-size: 32rpx;
  z-index: 2;
}

.search-input {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(40rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 88rpx;
  padding: 0 32rpx 0 80rpx;
  font-size: 28rpx;
  color: #3F302B;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
  box-sizing: border-box;
}

.search-input:focus {
  border-color: #E85D4A;
}

.placeholder {
  color: #A9958E;
}

/* 快捷功能网格 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.feature-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.feature-card:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}

.icon-container {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2);
}

.gradient-green {
  background: linear-gradient(135deg, #F6C85F 0%, #E5AA3E 100%);
}

.gradient-purple {
  background: linear-gradient(135deg, #E85D4A 0%, #D94A3A 100%);
}

.gradient-orange {
  background: linear-gradient(135deg, #B97850 0%, #945C3D 100%);
}

.feature-icon {
  position: relative;
  width: 64rpx;
  height: 64rpx;
}

.feature-icon-img {
  width: 82rpx;
  height: 82rpx;
}

.wish-paper {
  position: absolute;
  left: 11rpx;
  top: 8rpx;
  width: 42rpx;
  height: 50rpx;
  background: rgba(255,255,255,0.96);
  border-radius: 10rpx;
  box-shadow: inset 0 -6rpx 0 rgba(255,255,255,0.32);
}

.wish-heart {
  position: absolute;
  left: 15rpx;
  top: 10rpx;
  width: 14rpx;
  height: 14rpx;
  background: #E85D4A;
  transform: rotate(45deg);
}

.wish-heart::before,
.wish-heart::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  background: #E85D4A;
  border-radius: 50%;
}

.wish-heart::before {
  left: -7rpx;
  top: 0;
}

.wish-heart::after {
  left: 0;
  top: -7rpx;
}

.wish-line {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  width: 24rpx;
  height: 4rpx;
  background: #F2C66D;
  border-radius: 6rpx;
}

.wish-line.line-short {
  bottom: 18rpx;
  width: 18rpx;
}

.floating {
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
  40% { transform: translateY(-20rpx); }
  60% { transform: translateY(-10rpx); }
}

.feature-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #3F302B;
}

/* 热门菜谱区域 */
.hot-recipes {
  margin-bottom: 48rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #3F302B;
}

.view-more {
  display: flex;
  align-items: center;
  color: #E85D4A;
  font-size: 24rpx;
  font-weight: 500;
}

.more-text {
  margin-right: 8rpx;
}

/* 菜谱列表 */
.recipes-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.recipe-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(30rpx);
  border-radius: 32rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,0.1);
}

.recipe-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.08);
}

.recipe-image-container {
  position: relative;
  margin-bottom: 24rpx;
}

.recipe-image {
  width: 100%;
  height: 240rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
}

.favorite-button {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(232, 93, 74, 0.2);
  box-shadow: 0 6rpx 18rpx rgba(63, 48, 43, 0.16);
  transition: transform 0.2s ease, background 0.2s ease;
}

.favorite-button.active {
  background: #E85D4A;
  border-color: #E85D4A;
}

.favorite-button:active {
  transform: scale(0.9);
}

.favorite-button.loading {
  opacity: 0.55;
}

.favorite-icon {
  color: #E85D4A;
  font-size: 38rpx;
  line-height: 1;
}

.favorite-button.active .favorite-icon {
  color: #ffffff;
}

.recipe-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #3F302B;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recipe-desc {
  display: block;
  font-size: 26rpx;
  color: #8C7770;
  margin-bottom: 20rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.recipe-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #A9958E;
}

.meta-item.views {
  color: #E85D4A;
  font-weight: 500;
}

.meta-text {
  font-size: 22rpx;
}

/* 加载和空状态 */
.loading-container,
.empty-container {
  text-align: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #8C7770;
}

.empty-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8C7770;
}
