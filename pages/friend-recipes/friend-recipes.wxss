.friend-recipes-page {
  min-height: 100vh;
  padding: 28rpx 30rpx 60rpx;
  box-sizing: border-box;
  background: #FFF9ED;
}

.page-intro {
  padding: 10rpx 4rpx 26rpx;
}

.page-title,
.page-desc {
  display: block;
}

.page-title {
  overflow: hidden;
  color: #3F302B;
  font-size: 38rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.page-desc {
  margin-top: 8rpx;
  color: #A9958E;
  font-size: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin-bottom: 26rpx;
  padding: 0 24rpx;
  border: 1rpx solid #EFE2DA;
  border-radius: 18rpx;
  background: #FFFFFF;
}

.search-input {
  min-width: 0;
  flex: 1;
  height: 76rpx;
  margin-left: 14rpx;
  color: #4E3B35;
  font-size: 26rpx;
}

.clear-search {
  width: 48rpx;
  color: #A9958E;
  font-size: 34rpx;
  text-align: right;
}

.recipe-list {
  display: flex;
  flex-direction: column;
}

.page-state {
  display: flex;
  min-height: 48vh;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 100rpx;
  box-sizing: border-box;
  color: #A9958E;
  font-size: 26rpx;
}

.loading-spinner {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 20rpx;
  border: 4rpx solid #F0E3DA;
  border-top-color: #E85D4A;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-icon {
  font-size: 82rpx;
}

.empty-title {
  margin-top: 20rpx;
  color: #6E5852;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 12rpx;
  color: #A9958E;
  font-size: 24rpx;
}

.list-tip {
  padding: 24rpx 0 8rpx;
  color: #B39D95;
  font-size: 22rpx;
  text-align: center;
}
