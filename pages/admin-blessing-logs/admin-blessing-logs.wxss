.log-page { min-height: 100vh; padding: 24rpx 28rpx calc(50rpx + env(safe-area-inset-bottom)); box-sizing: border-box; color: #3F302B; background: #FFF9ED; }
.log-hero { display: flex; align-items: center; justify-content: space-between; padding: 30rpx 32rpx; color: #FFF; border-radius: 24rpx; background: #D95B67; }
.hero-title, .hero-desc { display: block; }.hero-title { font-size: 36rpx; font-weight: 700; }.hero-desc { margin-top: 8rpx; color: rgba(255,255,255,.8); font-size: 22rpx; }.hero-icon { font-size: 52rpx; }
.category-tabs { display: flex; gap: 16rpx; margin: 24rpx 0; }.category-tab { flex: 1; padding: 18rpx 0; color: #8C7770; font-size: 26rpx; text-align: center; border-radius: 16rpx; background: #F2E7E0; }.category-tab.active { color: #FFF; font-weight: 600; background: #D95B67; }
.summary-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }.summary-grid view { display: flex; min-height: 102rpx; flex-direction: column; justify-content: center; padding: 16rpx; box-sizing: border-box; border: 1rpx solid #F2E4DE; border-radius: 16rpx; background: #FFF; }.summary-grid text:first-child { color: #D95B67; font-size: 32rpx; font-weight: 700; }.summary-grid text:last-child { margin-top: 6rpx; color: #8C7770; font-size: 19rpx; }
.status-scroll { margin: 24rpx -28rpx 0; white-space: nowrap; }.status-tabs { display: inline-flex; gap: 12rpx; padding: 0 28rpx; }.status-tab { padding: 12rpx 20rpx; color: #8C7770; font-size: 22rpx; border-radius: 24rpx; background: #F1E7E1; }.status-tab.active { color: #A43D49; background: #FFE6E8; }
.page-state { padding: 120rpx 0; color: #9A8780; font-size: 24rpx; text-align: center; }.log-list { margin-top: 20rpx; }.log-card { margin-bottom: 16rpx; padding: 22rpx; border-radius: 18rpx; background: #FFF; box-shadow: 0 5rpx 16rpx rgba(63,48,43,.05); }.people-row { display: flex; align-items: center; min-width: 0; gap: 9rpx; }.avatar { width: 42rpx; height: 42rpx; flex-shrink: 0; border-radius: 50%; background: #F4E9E3; }.person-name { max-width: 100rpx; overflow: hidden; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }.person-name.recipient { flex: 1; }.arrow { color: #B49D93; }.delivery-status { padding: 5rpx 10rpx; color: #B34755; font-size: 18rpx; border-radius: 8rpx; background: #FFF0F0; }.log-title { display: block; margin: 18rpx 0 12rpx; overflow: hidden; font-size: 27rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }.log-meta { display: flex; justify-content: space-between; margin-top: 6rpx; color: #8C7770; font-size: 20rpx; }
.detail-mask { position: fixed; z-index: 10; inset: 0; display: flex; align-items: flex-end; background: rgba(35,24,20,.45); }.detail-panel { width: 100%; max-height: 76vh; padding: 30rpx; box-sizing: border-box; overflow-y: auto; border-radius: 28rpx 28rpx 0 0; background: #FFF9ED; }.detail-top { display: flex; align-items: center; justify-content: space-between; }.detail-title { font-size: 32rpx; font-weight: 700; }.close { width: 54rpx; height: 54rpx; color: #8C7770; font-size: 42rpx; line-height: 50rpx; text-align: center; }.detail-route { display: block; margin-top: 20rpx; color: #8C7770; font-size: 22rpx; }.detail-subject { display: block; margin: 18rpx 0; font-size: 32rpx; font-weight: 700; }.detail-content { display: block; padding: 20rpx; color: #5B4640; font-size: 25rpx; line-height: 1.8; white-space: pre-wrap; border-radius: 14rpx; background: #FFF; }.detail-info { display: flex; justify-content: space-between; padding: 18rpx 0; color: #8C7770; font-size: 22rpx; border-bottom: 1rpx solid #F0E5DF; }.detail-info text:last-child { color: #3F302B; }.detail-error { margin-top: 18rpx; padding: 16rpx; color: #A43D49; font-size: 20rpx; border-radius: 12rpx; background: #FFF0F0; }
