.compose-page { min-height:100vh; padding:24rpx 24rpx calc(60rpx + env(safe-area-inset-bottom)); box-sizing:border-box; background:#FFF9ED; color:#3F302B; }.section-card { margin-bottom:22rpx; padding:28rpx; border:1rpx solid #EFE3DB; border-radius:28rpx; background:#fff; box-shadow:0 6rpx 18rpx rgba(63,48,43,.05); }.section-heading { display:flex; align-items:flex-end; justify-content:space-between; }.section-title { font-size:29rpx; font-weight:700; }.section-desc { color:#AA958D; font-size:20rpx; }.template-scroll { width:100%; margin-top:22rpx; white-space:nowrap; }.template-row { display:inline-flex; gap:15rpx; padding:3rpx 4rpx 10rpx; }.template-item { position:relative; display:flex; width:136rpx; height:120rpx; align-items:center; justify-content:center; flex-direction:column; box-sizing:border-box; border:3rpx solid transparent; border-radius:22rpx; background:linear-gradient(135deg,#FFF3D0,#FFE4DC); }.template-item.active { border-color:#E85D4A; box-shadow:0 7rpx 15rpx rgba(232,93,74,.16); }.template-emoji { font-size:37rpx; }.template-name { margin-top:7rpx; color:#5D4841; font-size:22rpx; }.template-check { position:absolute; top:-9rpx; right:-7rpx; width:32rpx; height:32rpx; color:#fff; font-size:19rpx; line-height:32rpx; text-align:center; border:4rpx solid #fff; border-radius:50%; background:#E85D4A; }
.blessing-preview { position:relative; overflow:hidden; min-height:285rpx; margin-bottom:22rpx; padding:36rpx 34rpx; box-sizing:border-box; border-radius:32rpx; background:linear-gradient(145deg,#FFE7A8,#FFD9D3); box-shadow:0 12rpx 28rpx rgba(92,57,43,.1); text-align:center; }.preview-spark { position:absolute; border-radius:50%; background:rgba(255,255,255,.35); }.spark-one { width:180rpx;height:180rpx;top:-80rpx;left:-45rpx; }.spark-two { width:130rpx;height:130rpx;right:-40rpx;bottom:-60rpx; }.preview-emoji,.preview-title,.preview-content,.preview-sign { position:relative;z-index:1;display:block; }.preview-emoji { font-size:48rpx; }.preview-title { margin-top:10rpx;font-size:34rpx;font-weight:800; }.preview-content { margin:16rpx auto 0;max-width:540rpx;color:#6F554D;font-size:25rpx;line-height:1.65; }.preview-sign { margin-top:18rpx;color:#A27869;font-size:20rpx; }
.field-label { display:block;color:#5A4640;font-size:24rpx;font-weight:600; }.space-top { margin-top:25rpx; }.required { color:#E85D4A; }.picker-field,.text-field { height:78rpx;margin-top:12rpx;padding:0 22rpx;box-sizing:border-box;color:#3F302B;font-size:25rpx;line-height:78rpx;border-radius:20rpx;background:#FFF9F2;box-shadow:inset 0 0 0 1rpx #EEE2DA; }.picker-field { display:flex;align-items:center;justify-content:space-between; }.picker-field.muted { color:#A9958E; }.picker-arrow { color:#A9958E;font-size:28rpx; }
.selected-friend { display:flex;min-width:0;align-items:center; }.selected-friend-avatar { width:52rpx;height:52rpx;flex-shrink:0;border-radius:50%;background:#F1E8E2; }.selected-friend-copy { display:flex;min-width:0;margin-left:14rpx;align-items:baseline;line-height:1.2; }.selected-friend-name { overflow:hidden;max-width:280rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap; }.selected-friend-nickname { overflow:hidden;max-width:220rpx;color:#A28E87;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap; }
.rich-editor-wrap { position:relative;overflow:hidden;margin-top:12rpx;padding-bottom:38rpx;border-radius:20rpx;background:#FFF9F2;box-shadow:inset 0 0 0 1rpx #EEE2DA; }.editor-toolbar { display:flex;overflow-x:auto;padding:12rpx 14rpx;align-items:center;gap:8rpx;border-bottom:1rpx solid #EDE0D8;background:#FFFDFC;white-space:nowrap; }.toolbar-button { display:flex;min-width:48rpx;height:48rpx;padding:0 8rpx;align-items:center;justify-content:center;box-sizing:border-box;color:#745D55;font-size:20rpx;border-radius:11rpx;background:#F6EEE9; }.toolbar-button:active { color:#D94A3A;background:#FFE9DF; }.toolbar-button.strong { font-weight:800; }.toolbar-button.italic { font-style:italic; }.toolbar-button.underline { text-decoration:underline; }.toolbar-button.color-warm { color:#E85D4A;font-weight:800; }.toolbar-divider { width:1rpx;height:34rpx;margin:0 3rpx;flex-shrink:0;background:#E2D3CB; }.content-editor { width:100%;min-height:220rpx;padding:20rpx 22rpx;box-sizing:border-box;color:#3F302B;font-size:25rpx;line-height:1.7; }.count-text { position:absolute;right:20rpx;bottom:12rpx;color:#B4A09A;font-size:20rpx; }.count-text.over-limit { color:#E5483D; }.rich-preview { text-align:left; }
.mode-row { display:flex;gap:16rpx;margin-top:20rpx; }.mode-option { display:flex;min-width:0;flex:1;padding:20rpx 16rpx;align-items:center;box-sizing:border-box;border:2rpx solid transparent;border-radius:22rpx;background:#FFF9F2; }.mode-option.active { border-color:#E85D4A;background:#FFF0EA; }.mode-icon { margin-right:11rpx;font-size:30rpx; }.mode-title,.mode-desc { display:block; }.mode-title { font-size:23rpx;font-weight:700; }.mode-desc { margin-top:4rpx;color:#A28E87;font-size:18rpx; }.schedule-row { display:flex;gap:16rpx;margin-top:18rpx; }.schedule-row picker { flex:1; }.schedule-picker { height:70rpx;color:#5F4942;font-size:22rpx;line-height:70rpx;text-align:center;border-radius:18rpx;background:#F5ECE6; }.delivery-tip { display:block;margin-top:18rpx;color:#A08B84;font-size:20rpx;line-height:1.5; }.submit-button { height:88rpx;margin:30rpx 0 0;color:#fff;font-size:29rpx;font-weight:700;line-height:88rpx;border-radius:44rpx;background:linear-gradient(135deg,#F06B55,#E5473B);box-shadow:0 11rpx 25rpx rgba(232,93,74,.24); }.submit-button::after { border:0; }.submit-button[disabled] { color:#B9A9A2;background:#EFE7E2;box-shadow:none; }
.theme-night,.theme-qixi { background:linear-gradient(145deg,#E7E2FF,#CFD9FF); }.theme-morning,.theme-labor { background:linear-gradient(145deg,#FFF2B8,#FFE1A6); }.theme-anniversary,.theme-valentine,.theme-missing-you { background:linear-gradient(145deg,#FFE5EB,#FFD5D9); }.theme-birthday,.theme-children { background:linear-gradient(145deg,#E7F9ED,#DDF2FF); }.theme-eat-well,.theme-waiting-home,.theme-warm-hug { background:linear-gradient(145deg,#FFF0D2,#FFE0C9); }
.friend-selector-mask { position:fixed;inset:0;z-index:13000;display:flex;align-items:flex-end;background:rgba(43,31,27,.52); }.friend-selector-sheet { width:100%;max-height:72vh;padding:12rpx 24rpx calc(26rpx + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:36rpx 36rpx 0 0;background:#FFF9ED;box-shadow:0 -16rpx 40rpx rgba(63,48,43,.14); }.friend-selector-handle { width:74rpx;height:8rpx;margin:4rpx auto 22rpx;border-radius:8rpx;background:#E1D4CC; }.friend-selector-heading { display:flex;padding:0 8rpx 24rpx;align-items:center;justify-content:space-between; }.friend-selector-title,.friend-selector-desc { display:block; }.friend-selector-title { color:#3F302B;font-size:32rpx;font-weight:800; }.friend-selector-desc { margin-top:7rpx;color:#A28E87;font-size:21rpx; }.friend-selector-close { display:flex;width:58rpx;height:58rpx;align-items:center;justify-content:center;color:#947E76;font-size:40rpx;border-radius:50%;background:#F5EAE3; }.friend-selector-list { max-height:52vh; }.friend-option { display:flex;margin-bottom:14rpx;padding:20rpx;align-items:center;box-sizing:border-box;border:2rpx solid transparent;border-radius:24rpx;background:#fff;box-shadow:0 5rpx 16rpx rgba(63,48,43,.05); }.friend-option.active { border-color:#E85D4A;background:#FFF1EA;box-shadow:0 8rpx 20rpx rgba(232,93,74,.12); }.friend-option-avatar { width:82rpx;height:82rpx;flex-shrink:0;border:3rpx solid #fff;border-radius:50%;background:#F1E8E2;box-shadow:0 4rpx 12rpx rgba(63,48,43,.1); }.friend-option-copy { min-width:0;margin-left:18rpx;flex:1; }.friend-option-name-row { display:flex;align-items:baseline; }.friend-option-name { overflow:hidden;max-width:270rpx;color:#3F302B;font-size:28rpx;font-weight:750;text-overflow:ellipsis;white-space:nowrap; }.friend-option-nickname { overflow:hidden;max-width:220rpx;color:#A28E87;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap; }.friend-option-role { display:block;margin-top:8rpx;color:#B09A92;font-size:20rpx; }.friend-option