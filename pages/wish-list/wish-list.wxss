.wish-page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: #FFF9ED;
}

.wish-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #3F302B;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #8C7770;
}

.loading-state,
.empty-state {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #8C7770;
}

.empty-icon {
  font-size: 72rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #6E5852;
}

.empty-desc {
  font-size: 26rpx;
}

.wish-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.wish-swipe-row {
  position: relative;
  overflow: hidden;
  border: 0;
  border-radius: 20rpx;
  background: transparent;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.08);
}

.wish-delete-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  width: 76px;
  align-items: center;
  justify-content: center;
  border: 0;
  background: #E5484D;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
}

.wish-card {
  position: relative;
  z-index: 1;
  width: 100%;
  padding: 28rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: none;
  transition: transform 0.18s ease;
}

.wish-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.wish-cover {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: #F5ECE6;
}

.wish-content {
  flex: 1;
  min-width: 0;
}

.wish-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #3F302B;
}

.wish-note {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #8C7770;
}

.wish-submitter {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #6E5852;
}

.submitter-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #E8DED8;
  color: #8C7770;
  font-size: 22rpx;
}

.submitter-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-badge {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #D94A3A;
  background: #FFF1D6;
}

.status-rejected .status-badge,
.status-cancelled .status-badge {
  color: #dc2626;
  background: #fee2e2;
}

.status-accepted .status-badge,
.status-in_cart .status-badge {
  color: #059669;
  background: #d1fae5;
}

.status-ordered .status-badge,
.status-done .status-badge {
  color: #7c3aed;
  background: #ede9fe;
}

.wish-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
  font-size: 24rpx;
  color: #A9958E;
}

.reject-reason {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #991b1b;
  background: #fef2f2;
}

.wish-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 28rpx;
}

.wish-share-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  margin: 0;
  border: 1rpx solid #E8DED8;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6E5852;
  font-size: 24rpx;
}

.wish-share-btn::after {
  border: 0;
}

.modal-panel {
  padding: 32rpx;
  padding-bottom: 52rpx;
  background: #ffffff;
}

.modal-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #3F302B;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 32rpx;
}
