<view wx:if="{{hasLoaded}}" class="admin-page">
  <view class="admin-hero">
    <view class="admin-crown">♛</view>
    <view class="admin-hero-content">
      <text class="admin-title">管理员工作台</text>
      <text class="admin-subtitle">管理身份与投喂关系，守护每一顿饭</text>
    </view>
  </view>

  <view class="section-title">系统概览</view>
  <view class="stats-grid">
    <view class="stat-card" data-role="" bindtap="openUsers">
      <text class="stat-value">{{stats.userCount}}</text>
      <text class="stat-name">全部用户</text>
      <text class="stat-link">查看 ›</text>
    </view>
    <view class="stat-card warm" data-role="feeder" bindtap="openUsers">
      <text class="stat-value">{{stats.feederCount}}</text>
      <text class="stat-name">投喂官</text>
      <text class="stat-link">查看 ›</text>
    </view>
    <view class="stat-card alert" data-type="orders" bindtap="openDataList">
      <text class="stat-value">{{stats.activeOrderCount}}</text>
      <text class="stat-name">进行中投喂单</text>
      <text class="stat-link">查看 ›</text>
    </view>
    <view class="stat-card cream" data-type="recipes" bindtap="openDataList">
      <text class="stat-value">{{stats.recipeCount}}</text>
      <text class="stat-name">已发布菜品</text>
      <text class="stat-link">查看 ›</text>
    </view>
  </view>

  <view class="section-title">管理功能</view>
  <view class="admin-modules">
    <view wx:if="{{isPrimaryAdmin}}" class="module-card" bindtap="openAnalytics">
      <view class="module-icon analytics">▥</view>
      <view class="module-content">
        <text class="module-title">数据看板</text>
        <text class="module-desc">用户活跃、功能使用与投喂官菜谱</text>
      </view>
      <text class="module-arrow">›</text>
    </view>
    <view wx:if="{{isPrimaryAdmin}}" class="module-card" bindtap="openBlessingLogs">
      <view class="module-icon blessing-log">✦</view>
      <view class="module-content">
        <text class="module-title">祝福日志</text>
        <text class="module-desc">节日与好友祝福的送达、拆开记录</text>
      </view>
      <text class="module-arrow">›</text>
    </view>
    <view class="module-card" bindtap="openUsers">
      <view class="module-icon users">👥</view>
      <view class="module-content">
        <text class="module-title">用户与身份</text>
        <text class="module-desc">管理投喂身份与独立管理员权限</text>
      </view>
      <text class="module-arrow">›</text>
    </view>
    <view class="module-card" bindtap="openRelationships">
      <view class="module-icon relation">🍲</view>
      <view class="module-content">
        <text class="module-title">固定投喂关系</text>
        <text class="module-desc">查看并协助调整唯一固定投喂官</text>
      </view>
      <text class="module-arrow">›</text>
    </view>
  </view>

  <view class="admin-tip">
    <text class="tip-icon">🔒</text>
    <text>{{isPrimaryAdmin ? '埋点与运营数据仅主管理员可见，所有查询均由云端校验。' : '管理员操作由云端校验，并记录关键身份和关系变更。'}}</text>
  </view>

</view>
<view wx:else class="admin-page-loading">
  <view class="admin-loading-mark">♛</view>
  <van-loading type="spinner" size="28px" color="#E85D4A" />
  <text class="admin-loading-text">工作台加载中...</text>
</view>
<global-notification-popup id="globalNotificationPopup" />
