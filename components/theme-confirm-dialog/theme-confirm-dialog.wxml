<view wx:if="{{visible}}" class="dialog-mask" bindtap="onMaskTap" catchtouchmove="stopPropagation">
  <view class="dialog-card {{tone}}" catchtap="stopPropagation">
    <view class="dialog-hero">
      <view class="hero-icon">{{icon}}</view>
      <text class="dialog-kicker">{{kicker}}</text>
      <text class="dialog-title">{{title}}</text>
    </view>
    <text class="dialog-content">{{content}}</text>
    <view wx:if="{{extraText}}" class="dialog-actions stacked">
      <button class="dialog-button confirm" bindtap="confirm">{{confirmText}}</button>
      <button class="dialog-button extra" bindtap="extra">{{extraText}}</button>
      <button wx:if="{{showCancel}}" class="dialog-button cancel" bindtap="cancel">{{cancelText}}</button>
    </view>
    <view wx:else class="dialog-actions {{showCancel ? '' : 'single'}}">
      <button wx:if="{{showCancel}}" class="dialog-button cancel" bindtap="cancel">{{cancelText}}</button>
      <button class="dialog-button confirm" bindtap="confirm">{{confirmText}}</button>
    </view>
  </view>
</view>
