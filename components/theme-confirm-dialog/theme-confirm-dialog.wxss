.dialog-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 12000; display: flex; align-items: center; justify-content: center; padding: 40rpx; box-sizing: border-box; background: rgba(43, 31, 27, 0.58); }
.dialog-card { width: 100%; max-width: 620rpx; overflow: hidden; border: 1rpx solid rgba(232, 222, 216, 0.9); border-radius: 30rpx; background: #FFFDF9; box-shadow: 0 26rpx 80rpx rgba(45, 29, 24, 0.22); }
.dialog-hero { display: flex; flex-direction: column; align-items: center; padding: 34rpx 30rpx 28rpx; background: linear-gradient(135deg, #FFF0EA, #FFF5D9); }
.hero-icon { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; margin-bottom: 14rpx; border-radius: 50%; font-size: 38rpx; background: rgba(255, 255, 255, 0.86); box-shadow: 0 8rpx 22rpx rgba(217, 74, 58, 0.12); }
.dialog-kicker { color: #A06E5E; font-size: 21rpx; }
.dialog-title { margin-top: 7rpx; color: #3F302B; font-size: 34rpx; font-weight: 700; text-align: center; }
.dialog-content { display: block; padding: 30rpx 38rpx 6rpx; color: #765F57; font-size: 25rpx; line-height: 1.7; text-align: center; white-space: pre-line; }
.dialog-actions { display: grid; grid-template-columns: 1fr 1.35fr; gap: 18rpx; padding: 28rpx 30rpx calc(28rpx + env(safe-area-inset-bottom)); }
.dialog-button { height: 76rpx; margin: 0; padding: 0; border-radius: 18rpx; font-size: 25rpx; font-weight: 600; line-height: 76rpx; }
.dialog-button::after { border: none; }
.dialog-button.cancel { color: #8C7770; background: #F3ECE8; }
.dialog-button.confirm { color: #FFFFFF; background: linear-gradient(135deg, #E85D4A, #D94A3A); box-shadow: 0 8rpx 20rpx rgba(217, 74, 58, 0.2); }
.dialog-card.danger .dialog-hero { background: linear-gradient(135deg, #FFF0EA, #FFE6E3); }
.dialog-card.danger .dialog-button.confirm { background: linear-gradient(135deg, #E85D4A, #C93D35); }
