/* 菜谱项组件样式 */
.recipe-card {
  position: relative;
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  margin-bottom: 24rpx;
}

.recipe-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.recipe-content {
  display: flex;
  padding: 32rpx;
  gap: 32rpx;
  align-items: flex-start;
}

.recipe-content.compact {
  min-height: 128rpx;
  padding: 16rpx;
  gap: 16rpx;
  align-items: center;
}

.recipe-content.compact .recipe-image {
  width: 128rpx;
  height: 128rpx;
  border-radius: 12rpx;
}

.recipe-content.compact .recipe-info {
  gap: 10rpx;
}

.recipe-content.compact .recipe-title {
  font-size: 28rpx;
  -webkit-line-clamp: 2;
}

.recipe-tags.compact-tags {
  gap: 6rpx;
  max-height: 54rpx;
  overflow: hidden;
}

.compact-tags .recipe-tag {
  padding: 4rpx 8rpx;
  border-radius: 12rpx;
  font-size: 18rpx;
}

.recipe-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

/* 没图时的占位块：按食材分类显示图标 */
.recipe-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx dashed #E8DED8;
  background: linear-gradient(135deg, #FFF3EC, #FFF8E4);
}

.recipe-placeholder-emoji {
  font-size: 56rpx;
  line-height: 1;
  opacity: 0.85;
}

.recipe-content.compact .recipe-placeholder-emoji {
  font-size: 46rpx;
}

.recipe-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

.recipe-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3F302B;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recipe-description {
  font-size: 26rpx;
  color: #8C7770;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recipe-meta {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #A9958E;
}

.recipe-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.recipe-tag {
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  text-align: center;
  white-space: nowrap;
}

.scene-tag {
  background-color: #FFF4E8;
  color: #D94A3A;
}

.ingredient-tag {
  background-color: #e8f5e8;
  color: #388e3c;
}

.optional-tag {
  background-color: #fff3e0;
  color: #f57c00;
}

/* 菜谱状态标签 */
.recipe-status-tag {
  position: absolute;
  top: 0;
  right: 0;
  padding: 8rpx 16rpx 8rpx 20rpx;
  border-radius: 0 0 0 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  z-index: 10;
  color: #ffffff;
  min-width: 50rpx;
  text-align: center;
  letter-spacing: 0.5rpx;
}

.recipe-status-tag.draft {
  background-color: #f59e0b;
}

.recipe-status-tag.published {
  background-color: #10b981;
}

.status-text {
  font-size: 22rpx;
  font-weight: 600;
}

/* 购物车操作按钮 */
.cart-action {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  z-index: 10;
}

.add-to-cart-btn,
.remove-from-cart-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  box-shadow: 0 6rpx 16rpx rgba(59, 130, 246, 0.22);
  box-sizing: border-box;
}

.recipe-metrics {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  color: #A9958E;
  font-size: 20rpx;
}

.recipe-metric {
  display: inline-flex;
  align-items: center;
  gap: 5rpx;
}

.favorite-metric,
.favorite-stats {
  color: #E85D4A;
}

.sales-metric,
.sales-stats {
  color: #A9958E;
}

.view-metric,
.view-stats {
  color: #8C7770;
}

.viewer-info-action {
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
  background: #F5ECE6;
}

.rating-metric,
.rating-stats {
  color: #C58A16;
}

.compact-metrics {
  max-width: 100%;
}

.full-metrics {
  flex-wrap: nowrap;
  min-height: 28rpx;
  gap: 24rpx;
}

.cart-action.compact-cart-action {
  position: static;
  flex-shrink: 0;
}

.compact-cart-action .add-to-cart-btn,
.compact-cart-action .remove-from-cart-btn {
  width: 56rpx;
  min-width: 56rpx;
  height: 56rpx;
  padding: 0;
  border-radius: 50%;
  box-shadow: none;
}

.compact-cart-action .add-to-cart-btn {
  background: #F2E8E1;
  color: #A9958E;
}

.compact-cart-action .remove-from-cart-btn {
  background: #E85D4A;
  color: #ffffff;
}

.compact-cart-action .btn-text {
  font-size: 36rpx;
  font-weight: 400;
}

.add-to-cart-btn {
  background: linear-gradient(135deg, #E85D4A 0%, #D94A3A 100%);
  color: #ffffff;
}

.add-to-cart-btn:active {
  background-color: #D94A3A;
  transform: scale(0.95);
}

.remove-from-cart-btn {
  background: linear-gradient(135deg, #E85D4A 0%, #D94A3A 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(255, 71, 105, 0.22);
}

.remove-from-cart-btn:active {
  background-color: #C83D32;
  transform: scale(0.95);
}

.btn-text {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}
