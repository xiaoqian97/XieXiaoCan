/* 好友选择器组件样式 */
.friend-selector-content {
  width: 100%;
  height: 50vh;
  background-color: #ffffff;
  padding: 32rpx;
  padding-bottom: calc(32rpx + 100rpx);
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F5ECE6;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #3F302B;
}

.search-section {
  margin-bottom: 32rpx;
}

.friends-list {
  max-height: 60vh;
  overflow-y: auto;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 60rpx 0;
  color: #A9958E;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 60rpx 0;
}

.empty-emoji {
  font-size: 48rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #A9958E;
}

.friend-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  background-color: #FFF9ED;
  border: 1rpx solid #e9ecef;
  transition: all 0.2s ease;
}

.friend-item.selected {
  background-color: #FFF4E8;
  border-color: #E85D4A;
}

.friend-item.current-user {
  background-color: #FFF4E8;
  border-color: #E85D4A;
}

.friend-item.current-user.selected {
  background-color: #FFF4E8;
  border-color: #E85D4A;
}

.friend-item:active {
  transform: scale(0.98);
}

.friend-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 24rpx;
}

.friend-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.friend-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.friend-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #3F302B;
}

.current-user-label {
  font-size: 24rpx;
  color: #E85D4A;
  font-weight: 500;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background-color: rgba(33, 150, 243, 0.1);
}

.friend-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
}

.status-dot.online {
  background-color: #4caf50;
}

.status-dot.offline {
  background-color: #9e9e9e;
}

.status-text {
  font-size: 24rpx;
  color: #8C7770;
}

.selected-icon {
  margin-left: 16rpx;
}

