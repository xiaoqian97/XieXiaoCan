.share-mask { position:fixed;top:0;right:0;bottom:0;left:0;z-index:14000;display:flex;padding:40rpx;align-items:center;justify-content:center;box-sizing:border-box;background:rgba(43,31,27,.58); }
.share-card { position:relative;overflow:hidden;width:100%;max-width:620rpx;padding:42rpx 36rpx 34rpx;box-sizing:border-box;border-radius:36rpx;background:linear-gradient(165deg,#FFF5DF 0%,#FFFFFF 54%,#FFF9ED 100%);box-shadow:0 24rpx 70rpx rgba(43,31,27,.22);text-align:center; }
.share-glow { position:absolute;border-radius:50%;background:rgba(246,200,95,.2); }.glow-left { width:210rpx;height:210rpx;top:-110rpx;left:-90rpx; }.glow-right { width:170rpx;height:170rpx;right:-75rpx;bottom:-80rpx; }
.share-icon { position:relative;z-index:1;display:flex;width:94rpx;height:94rpx;margin:0 auto 18rpx;align-items:center;justify-content:center;border-radius:30rpx;background:linear-gradient(135deg,#F6C85F,#E85D4A);font-size:48rpx;box-shadow:0 12rpx 28rpx rgba(232,93,74,.22); }
.share-kicker,.share-title,.share-content,.share-tip { position:relative;z-index:1;display:block; }.share-kicker { color:#B97850;font-size:21rpx;font-weight:600;letter-spacing:2rpx; }.share-title { margin-top:10rpx;color:#3F302B;font-size:36rpx;font-weight:800; }.share-content { margin:20rpx auto 0;max-width:500rpx;color:#6E5852;font-size:26rpx;line-height:1.65; }.share-tip { margin-top:16rpx;color:#B09D96;font-size:20rpx; }
.share-actions { position:relative;z-index:1;display:flex;gap:16rpx;margin-top:32rpx; }.share-button { height:82rpx;flex:1;margin:0;padding:0;font-size:26rpx;font-weight:700;line-height:82rpx;border-radius:41rpx; }.share-button::after { border:0; }.share-button.done { color:#7E7470;background:#ECE9E7; }.share-button.primary { color:#fff;background:linear-gradient(135deg,#F06B53,#E5473B);box-shadow:0 10rpx 24rpx rgba(232,93,74,.24); }.share-button:active { transform:scale(.98); }
